paper.tex
# Local staging area for the artifacts.tar.gz/data.tar.gz built for the Zenodo upload -- the
# archives themselves are ~9 GB, never meant to be git-tracked.
/.release_staging/
# artifacts/ (checkpoints, split manifests, risk matrices, ~9 GB) and data/ (GTSRB / TT100K-Signs
# / LISA-Signs images, ~940 MB) are not git-tracked at all -- both are hosted as a Zenodo record
# instead (see README.md "Getting the data and checkpoints") and fetched with
# scripts/fetch_release_data.py. Committing either caused repeated git corruption on this
# NFS-backed filesystem back when data/ alone was ~75k small files.
/artifacts/
/data/
/outputs
note/tables/
note/ANALYSIS_RAW.md
note/figures/
outputs/ALL_RQ_DATA.txt
outputs/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
# Scratch verification runs (this session's own reproduction smoke tests), not shipped artifacts
outputs/repro_grid/
outputs/repro_run_real*/
outputs/_arachne_feat_cache/
# Raw per-sample prediction dumps (~24 GB total, not this artifact's to ship) -- needed
# locally to actually refit/reproduce DPGate (scripts/gate_lambda_sweep.py, gate_protocol_b.py,
# analyze_response_gate_lobo.py, analysis_gate_transplant.py, analysis_p1_regression.py); the
# CSV outputs those scripts write ARE the shipped evidence, this raw input is not.
outputs/effect_dump*/
outputs/_response_gate_cache*/
outputs/prior_patch_persample/
outputs/gate_persample*/
outputs/checkpoint_eval/
outputs/from_checkpoints/
outputs/gate_protocol_b.csv
